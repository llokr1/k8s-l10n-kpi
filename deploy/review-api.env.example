# Copy to a private environment file on the home PC.
REVIEW_API_PORT=3101
REVIEW_ALLOWED_ORIGINS=https://llokr1.github.io
REVIEW_ALLOWED_HOSTS=review-api.example.com,localhost,127.0.0.1
REVIEW_PUBLIC_SNAPSHOT_URL=https://llokr1.github.io/k8s-l10n-kpi/data/pr-management.json
REVIEW_GIT_DIRECTORY=/opt/ossca-review-info

# GitHub Actions workflow_dispatch. Keep the PAT on the server only.
# Share the trigger key only with operators; the browser stores it after the first use.
REVIEW_ACTIONS_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
REVIEW_ACTIONS_TRIGGER_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
REVIEW_ACTIONS_REPOSITORY=llokr1/k8s-l10n-kpi
REVIEW_ACTIONS_WORKFLOW=pr-management.yml
REVIEW_ACTIONS_REF=main

# Instead of a local Git checkout, these two values can be used on the server.
# PR_ASSIGNMENTS_REPOSITORY=OWNER/PRIVATE_REPOSITORY
# PR_ASSIGNMENTS_WRITE_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
